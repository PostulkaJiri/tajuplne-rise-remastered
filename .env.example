# LAN binding is fixed in docker-compose.yml: 192.168.0.249:18080 -> 8000.

# PaddleOCR
PADDLE_OCR_LANG=cs
PADDLE_OCR_VERSION=PP-OCRv5
PADDLE_DETECTION_MODEL=PP-OCRv5_mobile_det
PADDLE_RECOGNITION_MODEL=latin_PP-OCRv5_mobile_rec
PADDLE_DETECTION_MAX_SIDE=960
PADDLE_DETECTION_BOX_THRESHOLD=0.50
PADDLE_DEVICE=cpu
PADDLE_CPU_THREADS=2

# Two orientations cover sideways cards; measured against the local fixtures.
SCAN_ROTATIONS=0,-90

# Matching thresholds
MATCH_ACCEPT_SCORE=78
MATCH_HIGH_SCORE=92
MATCH_MIN_MARGIN=7
MIN_OCR_SCORE=0.32
MIN_TITLE_STYLE=0.30
TITLE_PREFILTER=true

# Legacy failed-scan debug copies remain disabled; the capture archive is separate.
DEBUG_SAVE_FAILED_SCANS=false

# Save new photographs/scan frames locally, never in the image or Git.
SAVE_CAPTURED_IMAGES=true
CAPTURE_STORAGE_MAX_BYTES=5000000000
MAX_ORIGINAL_PHOTO_BYTES=25000000
