# Public HTTP port exposed by the Docker stack.
# Put your existing reverse proxy / TLS termination in front of this port.
APP_PORT=8080

# PaddleOCR
PADDLE_OCR_LANG=cs
PADDLE_OCR_VERSION=PP-OCRv6
PADDLE_DEVICE=cpu
PADDLE_CPU_THREADS=6

# Multiple rotations improve tilted-title recall at the cost of CPU time.
SCAN_ROTATIONS=0,-22,22

# Matching thresholds
MATCH_ACCEPT_SCORE=78
MATCH_HIGH_SCORE=92
MATCH_MIN_MARGIN=7
MIN_OCR_SCORE=0.32
MIN_TITLE_STYLE=0.30

# Disabled by default: frames are not stored.
DEBUG_SAVE_FAILED_SCANS=false
